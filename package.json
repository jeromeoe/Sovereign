{
  "name": "sovereign",
  "version": "0.1.7",
  "description": "A private, source-grounded AI tutoring companion.",
  "author": "Sovereign",
  "private": true,
  "main": "companion/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "bridge": "node bridge/server.mjs",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/companion-update.test.mjs && node tests/bridge-ingestion.mjs",
    "test:bridge": "node tests/bridge-smoke.mjs",
    "companion": "electron companion/main.mjs",
    "companion:dir": "electron-builder --win dir --x64",
    "companion:build": "electron-builder --win nsis --x64",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@openai/codex-sdk": "^0.146.0",
    "drizzle-orm": "0.45.2",
    "jszip": "^3.10.1",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "build": {
    "appId": "com.sovereign.study",
    "productName": "Sovereign Companion",
    "artifactName": "Sovereign-Companion-Setup-${version}.${ext}",
    "protocols": [
      {
        "name": "Sovereign Companion",
        "schemes": [
          "sovereign"
        ]
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "asarUnpack": [
      "node_modules/@openai/codex/**",
      "node_modules/@openai/codex-win32-x64/**"
    ],
    "files": [
      "companion/**/*",
      "bridge/**/*",
      "public/favicon.svg",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*",
      "package.json",
      "!node_modules/@img{,/**/*}",
      "!node_modules/@next{,/**/*}",
      "!node_modules/@openai/codex-sdk{,/**/*}",
      "!node_modules/@swc{,/**/*}",
      "!node_modules/baseline-browser-mapping{,/**/*}",
      "!node_modules/caniuse-lite{,/**/*}",
      "!node_modules/client-only{,/**/*}",
      "!node_modules/detect-libc{,/**/*}",
      "!node_modules/drizzle-orm{,/**/*}",
      "!node_modules/lucide-react{,/**/*}",
      "!node_modules/next{,/**/*}",
      "!node_modules/react{,/**/*}",
      "!node_modules/react-dom{,/**/*}",
      "!node_modules/scheduler{,/**/*}",
      "!node_modules/semver{,/**/*}",
      "!node_modules/sharp{,/**/*}"
    ],
    "directories": {
      "output": "companion-dist"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Sovereign Companion",
      "runAfterFinish": true
    }
  },
  "type": "module"
}
